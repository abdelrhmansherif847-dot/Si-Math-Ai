+/* ── sources ──
+ * "Where This Analysis Comes From" must show each weakness signal under its
+ * ACTUAL source. The previous implementation had two hardcoded boxes and
+ * bucketed by `source !== 'AI_CHAT'`, so every non-chat source was displayed as
+ * "Mock Exams" — Focus Practice signals (the large majority of non-chat rows)
+ * were reported to students as mock exams, and signals with a NULL source were
+ * counted in neither box. Boxes are now generated from the sources actually
+ * present, so a new source added later shows up under its own name instead of
+ * being silently absorbed into an existing bucket.
+ */
+const SOURCE_LABELS={
+  AI_CHAT:'AI Tutor',
+  MOCK_EXAM:'Mock Exam',
+  FOCUS_PRACTICE:'Focus Practice',
+  STUDY_PLANNER:'Study Planner',
+  MANUAL_PRACTICE:'Manual Practice',
+};
+/* Forward-compatible: an unrecognised source renders under a readable version
+ * of its own key (FUTURE_ENGINE → "Future Engine") rather than being folded
+ * into another source's count. */
+function sourceLabel(src){
+  const key=(src||'').toString().trim().toUpperCase();
+  if(!key)return'Unknown Source';
+  if(SOURCE_LABELS[key])return SOURCE_LABELS[key];
+  return key.toLowerCase().split(/[_\s]+/).filter(Boolean)
+    .map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
+}
+/* mockExamCount is the number of COMPLETED mock exams from
+ * exam_practice_sessions — not a signal count. A student who sat 3 mock exams
+ * sees 3, whatever number of weakness signals those exams produced. */
+function renderSources(signals,mockExamCount){
+  const row=document.querySelector('.sources-row');
+  if(!row)return;
+  const counts=new Map();
+  (signals||[]).forEach(s=>{
+    const key=(s&&s.source?String(s.source).trim().toUpperCase():'')||'UNKNOWN';
+    counts.set(key,(counts.get(key)||0)+1);
+  });
+  // Mock Exam is reported as completed exams, from the exam table. Show the box
+  // whenever the student has sat an exam, even if it produced no signals (a
+  // clean exam is still a source this analysis drew on).
+  const entries=[];
+  const seen=new Set();
+  const ORDER=['AI_CHAT','MOCK_EXAM','FOCUS_PRACTICE','STUDY_PLANNER','MANUAL_PRACTICE'];
+  ORDER.forEach(key=>{
+    seen.add(key);
+    if(key==='MOCK_EXAM'){
+      const n=Number(mockExamCount)||0;
+      if(n>0)entries.push({label:SOURCE_LABELS[key],value:n});
+      return;
+    }
+    const n=counts.get(key)||0;
+    if(n>0)entries.push({label:SOURCE_LABELS[key],value:n});
+  });
+  // Any source not in ORDER (future engines, legacy values, NULL) — never drop it.
+  Array.from(counts.keys()).filter(k=>!seen.has(k)).sort().forEach(k=>{
+    entries.push({label:sourceLabel(k==='UNKNOWN'?'':k),value:counts.get(k)});
+  });
+  if(!entries.length){
+    row.innerHTML='<div class="src-box"><span class="src-v">0</span><span class="src-l">No Sources Yet</span></div>';
+    return;
+  }
+  row.innerHTML=entries.map(e=>
+    `<div class="src-box"><span class="src-v">${e.value}</span><span class="src-l">${esc(e.label)}</span></div>`
+  ).join('<span class="src-plus">+</span>');
 }
 
